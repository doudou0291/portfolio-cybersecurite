<!--
  Bloc d'intégration ajouté dans /var/ossec/etc/ossec.conf (Wazuh Manager)
  hook_url : passerelle du réseau Docker du Manager + port publié de TheHive.
  Récupérer la passerelle avec :
    sudo docker inspect single-node-wazuh.manager-1 \
      --format '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
-->
<integration>
  <name>custom-w2thive</name>
  <hook_url>http://172.19.0.1:9000</hook_url>
  <api_key>REMPLACER_PAR_VOTRE_CLE_API_THEHIVE</api_key>
  <level>0</level>
  <alert_format>json</alert_format>
</integration>
